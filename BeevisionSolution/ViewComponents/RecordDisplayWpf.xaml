<UserControl
    x:Class="BeevisionSolution.Views.RecordDisplayWpf"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:asf="clr-namespace:Microsoft.DwayneNeed.Interop;assembly=Microsoft.DwayneNeed"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    d:DesignHeight="300" d:DesignWidth="500" Background="{StaticResource PanelBrush}"
    mc:Ignorable="d">
    <Border Grid.Column="0"  Margin="2" BorderThickness="1" BorderBrush="Silver">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <!--Screen Watermark-->
            <Border Grid.Row="0" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                   Text="{Binding ScreenWatermark, FallbackValue=BeeVision Solution}" 
                   Foreground="White" 
                   FontWeight="Bold" 
                   FontSize="16" 
                   Margin="5,5"
                   VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TimingInfo}"
                               Foreground="#00FF00"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="12,5,145,5"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                   x:Name="txtRetryInfo"
                   Text="{Binding RetryInfo}" 
                   Foreground="Yellow" 
                   FontWeight="Bold" 
                   FontSize="14" 
                   Margin="5,5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"/>
                </Grid>
            </Border>


            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="Black">
                <WindowsFormsHost Background="#0d0d0d" Name="hostParent" Visibility="Visible"/>
            </Border>

            <!-- MARK(x,y) -->
            <TextBlock Grid.Column="0" x:Name="txtMark" Grid.RowSpan="2" Grid.Row="2" Foreground="#00FF00" FontSize="14" VerticalAlignment="Center" >
            </TextBlock>

            <!-- SCORE -->
            <TextBlock Grid.Column="1"   Grid.RowSpan="2" Grid.Row="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"  >
							<Run Text="{DynamicResource strScore}"/>
							<Run x:Name="txtCore" Text="0.000" Foreground="#00ff00"/>
            </TextBlock>
            <TextBlock Grid.Column="2" Grid.Row="2" Name="txtTactTime" Foreground="#00ff00" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <!-- Result -->
            <Viewbox Margin="0,0,5,0" Grid.Column="2" Grid.Row="2" Grid.RowSpan="2"  HorizontalAlignment="Right"  StretchDirection="DownOnly" Stretch="Uniform">
                <TextBlock x:Name="txtFooter" Margin="3" Text="OK" Grid.ColumnSpan="2" Grid.Row="0" FontWeight="Bold" VerticalAlignment="Center" Foreground="#00FF00" FontSize="24"/>
            </Viewbox>
            <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
                <!--<TextBlock x:Name="txtActualDist" Text="{Binding ActualDist, StringFormat='{}Dist: {0:F3} mm'}" Foreground="Yellow" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>-->
                <Button x:Name="btnSoloLive"
                        Click="BtnSoloLive_Click"
                        Width="30"
                        Padding="0"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource strLiveSingleDisplay}">
                    <iconPacks:PackIconMaterial x:Name="iconSoloLive" Width="18" Kind="Camcorder" Foreground="#CCCCCC"/>
                </Button>
                <Button x:Name="btnGrabImage"
                        Click="BtnGrabImage_Click"
                        Width="30"
                        Padding="0"
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        ToolTip="Grab Image">
                    <iconPacks:PackIconMaterial Width="18" Kind="Camera" Foreground="#CCCCCC"/>
                </Button>
                <Button x:Name="btnMeasureDistance"
                        Click="BtnMeasureDistance_Click"
                        Width="30"
                        Padding="0"
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        ToolTip="Measure Distance">
                    <iconPacks:PackIconMaterial Width="18" Kind="RulerSquare" Foreground="#CCCCCC"/>
                </Button>
                <Button x:Name="btnCrossLine" Click="btnCrossLine_Click" Width="30" ToolTip="Cross Line" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Width="15" Kind="PlusOutline" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
