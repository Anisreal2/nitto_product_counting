<UserControl x:Class="BeevisionSolution.ViewComponents.LotInformation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:BeevisionSolution.ViewComponents"
             mc:Ignorable="d"
             d:DesignHeight="475" d:DesignWidth="450">
	<UserControl.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,5" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#9e9e9e" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42" />
                                <Setter Property="BorderBrush" Value="#FF8000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF8000" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TextBox Style -->
		<Style x:Key="CustomTextBoxStyle" TargetType="{x:Type TextBox}">
			<Setter Property="Height" Value="34"/>
			<Setter Property="Padding" Value="8,0,0,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="BorderBrush" Value="#CCCCCC"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type TextBox}">
						<Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
							<ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="BorderBrush" Value="#6A5ACD" TargetName="border"/>
							</Trigger>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="#6A5ACD" TargetName="border"/>
								<Setter Property="BorderThickness" Value="2" TargetName="border"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ComboBox Style -->
		<Style x:Key="CustomComboBoxStyle" TargetType="{x:Type ComboBox}">
			<Setter Property="Height" Value="34"/>
			<Setter Property="BorderBrush" Value="#CCCCCC"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="8,3,0,3"/>
		</Style>

		<!-- Button Base Style -->
		<Style x:Key="RoundButtonStyle" TargetType="{x:Type Button}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#F0F0FF" TargetName="border"/>
								<Setter Property="BorderBrush" Value="#6A5ACD" TargetName="border"/>
								<Setter Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                        Opacity="0.3" Color="#000000"/>
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#D8D8F8" TargetName="border"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Action Button Style -->
		<Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource RoundButtonStyle}">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Background" Value="#E6E6FA"/>
			<Setter Property="BorderBrush" Value="#D8D8D8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
		</Style>
	</UserControl.Resources>

	<Grid Background="#E5E5E5">
		<Border BorderBrush="Gray" BorderThickness="1" Margin="10" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Enhanced Header with Icon -->
				<Border Grid.Row="0" Background="#6A5ACD" CornerRadius="3,3,0,0">
					<Grid Margin="10,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<iconPacks:PackIconMaterial Kind="Information" Width="24" Height="24"
                                                  Foreground="White" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Text="{DynamicResource strModelInfo}" Margin="10,0,0,0"
                                  FontWeight="Bold" Foreground="White" FontSize="16"
                                  VerticalAlignment="Center"/>
					</Grid>
				</Border>

				<!-- Form Content with improved layout -->
				<Grid Grid.Row="1" Margin="20,15">
					<Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!--<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>-->
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

                    <!--<local:ModelsManagerView Grid.Column="0" Grid.Row="0"/>-->
                    <!--Model Selection with Icon--> 
					<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,10,15">
						<iconPacks:PackIconMaterial Kind="ViewDashboard" Width="18" Height="18"
                                                  Foreground="#6A5ACD" Margin="0,0,5,0"/>
                        <TextBlock Text="{DynamicResource strSelectedModel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
					</StackPanel>

					<ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,15"
                              Style="{StaticResource CustomComboBoxStyle}"
                              SelectedIndex="0" x:Name="cbbModels" Text="{Binding SelectedProfile, Mode=TwoWay}"
                              VerticalContentAlignment="Center">
						<ComboBoxItem Content="MODEL 1"/>
						<ComboBoxItem Content="MODEL 2"/>
						<ComboBoxItem Content="MODEL 3"/>
					</ComboBox>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">

                        <Button x:Name="btnCopyProfile"
							Style="{StaticResource ModernButton}"
							Click="btnCopyProfile_Click" 
							ToolTip="{DynamicResource strCreateCopyModel}" 
							Width="50"
							Height="30">
                            <StackPanel Orientation="Horizontal">
                                <Path Height="16" Width="16" 
									Margin="0,0,5,0"
									Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" 
									Stretch="Uniform" 
									Data="{DynamicResource Copy}"/>
                                <TextBlock VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnBackup" 
							Style="{StaticResource ModernButton}"
							Height="30" 
							Width="50"
							Click="btnBackup_Click" Visibility="Visible"
				
							ToolTip="{DynamicResource strCreateZipBackup}">
                            <StackPanel Orientation="Horizontal">
                                <Path Height="16" Width="16"
									Margin="0,0,5,0"
									Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}" 
									Stretch="Uniform" 
									Data="{DynamicResource Archive}"/>
                                <TextBlock VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBox x:Name="txtProfileName"
							  Grid.Column="1" Grid.Row="1" Height="30" 
                             ToolTip="{DynamicResource strCreateModelName}"
                             Style="{StaticResource CustomTextBoxStyle}"
                             Margin="0,0,0,0"
                             
								/>

                </Grid>

				<!-- Enhanced Button Panel with Gradient Buttons -->
				<Border Grid.Row="2" Background="#EEEEEE" CornerRadius="0,0,3,3">
					<Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
						<Grid Margin="20,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0" x:Name="btnOk" Foreground="White"
                                    Height="40" Margin="0,0,10,0" Click="OkButton_Click">
								<Button.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="#7A6ADC" Offset="0"/>
										<GradientStop Color="#6A5ACD" Offset="1"/>
									</LinearGradientBrush>
								</Button.Background>
								<Button.Template>
									<ControlTemplate TargetType="{x:Type Button}">
										<Border Background="{TemplateBinding Background}" CornerRadius="3"
                                                x:Name="btnBorder">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background">
													<Setter.Value>
														<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
															<GradientStop Color="#8A7AEC" Offset="0"/>
															<GradientStop Color="#7A6ADC" Offset="1"/>
														</LinearGradientBrush>
													</Setter.Value>
												</Setter>
												<Setter Property="Effect">
													<Setter.Value>
														<DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                                        Opacity="0.3" Color="#000000"/>
													</Setter.Value>
												</Setter>
											</Trigger>
											<Trigger Property="IsPressed" Value="True">
												<Setter Property="Background">
													<Setter.Value>
														<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
															<GradientStop Color="#5A4ABC" Offset="0"/>
															<GradientStop Color="#4A3AAD" Offset="1"/>
														</LinearGradientBrush>
													</Setter.Value>
												</Setter>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
								<StackPanel Orientation="Horizontal">
									<iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16"
                                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource strConfirm}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
								</StackPanel>
							</Button>

							<Button Grid.Column="1" x:Name="btnExit" Foreground="White"
                                    Height="40" Margin="10,0,0,0" Click="ExitButton_Click">
								<Button.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="#FF7070" Offset="0"/>
										<GradientStop Color="#FF5050" Offset="1"/>
									</LinearGradientBrush>
								</Button.Background>
								<Button.Template>
									<ControlTemplate TargetType="{x:Type Button}">
										<Border Background="{TemplateBinding Background}" CornerRadius="3"
                                                x:Name="btnBorder">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background">
													<Setter.Value>
														<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
															<GradientStop Color="#FF8080" Offset="0"/>
															<GradientStop Color="#FF6060" Offset="1"/>
														</LinearGradientBrush>
													</Setter.Value>
												</Setter>
												<Setter Property="Effect">
													<Setter.Value>
														<DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                                        Opacity="0.3" Color="#000000"/>
													</Setter.Value>
												</Setter>
											</Trigger>
											<Trigger Property="IsPressed" Value="True">
												<Setter Property="Background">
													<Setter.Value>
														<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
															<GradientStop Color="#E04040" Offset="0"/>
															<GradientStop Color="#D03030" Offset="1"/>
														</LinearGradientBrush>
													</Setter.Value>
												</Setter>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Button.Template>
								<StackPanel Orientation="Horizontal">
									<iconPacks:PackIconMaterial Kind="ExitRun" Width="16" Height="16"
                                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource strExit}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
								</StackPanel>
							</Button>
						</Grid>
					</Border>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>