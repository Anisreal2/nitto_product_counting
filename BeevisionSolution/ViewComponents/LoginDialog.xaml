<mah:CustomDialog x:Class="BeevisionSolution.ViewComponents.LoginDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  Width="600"
                  >

    <Border CornerRadius="8" Padding="20"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            >

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                <iconPacks:PackIconMaterial
                    Kind="AccountCircle"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                <TextBlock Text="{DynamicResource strWelcome}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1">

                <!-- Username -->
                <TextBlock Text="{DynamicResource strUsername}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial
                        Kind="Account"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Margin="5"/>

                    <TextBox x:Name="txtUsername"
                             VerticalContentAlignment="Center"
                             Grid.Column="1"
                             Height="36"
                             Padding="10,5"/>
                </Grid>

                <!-- Password -->
                <TextBlock Text="{DynamicResource strPassword}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial
                        Kind="Lock"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Margin="5"/>

                    <PasswordBox x:Name="txtPassword"
                                 VerticalContentAlignment="Center"
                                 Grid.Column="1"
                                 Height="36"
                                 Padding="10,5"/>
                </Grid>

                

            </StackPanel>
            <!-- Error message -->
            <TextBlock x:Name="txtMessage"
           Foreground="#E53935"
           TextAlignment="Center" 
           FontSize="12" Grid.Row="2" TextWrapping="Wrap"
           Margin="0,0,0,15"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="3"
            HorizontalAlignment="Right">

                <Button Content="{DynamicResource strCancel}"
                    Width="90"
                    Height="34"
                    Margin="0,0,10,0"
                    Style="{DynamicResource MahApps.Styles.Button.Dialog}"
                    Click="Cancel_Click"/>

                <Button Content="{DynamicResource strLogin}"
                    Width="110"
                    Height="34"
                    IsDefault="True"
                    Style="{DynamicResource MahApps.Styles.Button.Dialog}"
                    Click="Login_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</mah:CustomDialog>
