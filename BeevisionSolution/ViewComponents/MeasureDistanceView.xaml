<UserControl x:Class="BeevisionSolution.ViewComponents.MeasureDistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeevisionSolution.ViewComponents"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Style cho label thông tin point -->
        <Style x:Key="PointLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PointValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource InsiderBorder}" BorderThickness="1">
        <Grid Background="{StaticResource ControlColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Toolbar: Browse + Scale -->
                <RowDefinition Height="*"/>
                <!-- Image area -->
                <RowDefinition Height="Auto"/>
                <!-- Point info + result panel -->
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: Toolbar ==================== -->
            <Border Grid.Row="0" Background="#1E1E1E" Padding="8,6" BorderBrush="#444" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File path textblock -->
                    <Border Grid.Column="0" Background="#111" CornerRadius="3" Padding="6,4" Margin="0,0,6,0">
                        <TextBlock x:Name="txtFilePath" 
                                   Text="{DynamicResource strNoImageSelected}" 
                                   Foreground="#888"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Browse button -->
                    <Button x:Name="btnBrowse" 
                            Grid.Column="1"
                            Width="100" Height="30"
                            Margin="0,0,6,0"
                            Background="#0078D4"
                            Foreground="White"
                            Click="btnBrowse_Click"
                            ToolTip="Chọn ảnh từ máy">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource strBrowse}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="2" Text="Display:" Foreground="LightGray" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Border Grid.Column="3" Background="#111" CornerRadius="3" Padding="7,4" Margin="0,0,10,0">
                        <TextBlock x:Name="txtDisplayId"
                                   Text="--"
                                   Foreground="#00E5FF"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   MinWidth="24"
                                   TextAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="4" Text="Measure Scale:" Foreground="LightGray" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtScale"
                             Grid.Column="5"
                             Width="70" Height="28"
                             Text="1.0"
                             FontSize="13"
                             Background="#111"
                             Foreground="White"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,2,0"
                             ToolTip="Scale in millimeters per pixel"/>
                    <TextBlock Grid.Column="6" Text="mm/px" Foreground="#888" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Button x:Name="btnSaveScale"
                            Grid.Column="7"
                            Width="65" Height="30"
                            Margin="0,0,6,0"
                            Click="btnSaveScale_Click"
                            ToolTip="Save scale for this display">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Zoom Display -->
                    <Border Grid.Column="8" Background="#111" CornerRadius="3" Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="MagnifyPlusOutline" Width="14" Height="14" Foreground="#888" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtZoom" Text="100%" Foreground="#00E5FF" FontSize="13" VerticalAlignment="Center" MinWidth="45" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>




                </Grid>
            </Border>

            <!-- ==================== ROW 1: Cognex Display Area ==================== -->
            <Border Grid.Row="1" Background="Black" Margin="0">
                <Grid>
                    <!-- Cognex RecordDisplay Host -->
                    <WindowsFormsHost x:Name="wfHost" Margin="1" Background="Black"/>

                    <!-- Hướng dẫn khi chưa có ảnh -->
                    <TextBlock x:Name="txtGuide"                               
                               Text="{DynamicResource strGuideMeasure}"
                               Foreground="#555"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="40"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- ==================== ROW 2: Info Panel ==================== -->
            <Border Grid.Row="2" Background="#1A1A1A" Padding="10,8" BorderBrush="#444" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Point 1 info -->
                    <Border Grid.Column="0" Background="#1C1C2E" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#FF4081" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource strPoint1}" Style="{StaticResource SectionHeaderStyle}" Foreground="#FF4081"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="X: " Style="{StaticResource PointLabelStyle}"/>
                                <TextBlock x:Name="txtP1X" Text="--" Style="{StaticResource PointValueStyle}" MinWidth="60"/>
                                <TextBlock Text="  Y: " Style="{StaticResource PointLabelStyle}"/>
                                <TextBlock x:Name="txtP1Y" Text="--" Style="{StaticResource PointValueStyle}" MinWidth="60"/>
                                <TextBlock Text=" px" Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Grid.Column="1" Height="1" Background="#333" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Point 2 info -->
                    <Border Grid.Column="2" Background="#1C1C2E" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#00E676" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource strPoint2}" Style="{StaticResource SectionHeaderStyle}" Foreground="#00E676"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="X: " Style="{StaticResource PointLabelStyle}"/>
                                <TextBlock x:Name="txtP2X" Text="--" Style="{StaticResource PointValueStyle}" MinWidth="60"/>
                                <TextBlock Text="  Y: " Style="{StaticResource PointLabelStyle}"/>
                                <TextBlock x:Name="txtP2Y" Text="--" Style="{StaticResource PointValueStyle}" MinWidth="60"/>
                                <TextBlock Text=" px" Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Grid.Column="3" Height="1" Background="#333" VerticalAlignment="Center" Margin="4,0"/>

                    <!-- Distance result -->
                    <Border Grid.Column="4" Background="#0D2137" CornerRadius="4" Padding="14,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <iconPacks:PackIconMaterial Kind="RulerSquare" Width="18" Height="18" Foreground="Red" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource strDistanceResult}" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="H:" Foreground="#00E5FF" FontSize="12" FontFamily="Consolas" MinWidth="20"/>
                                <TextBlock x:Name="txtHorizontal" Text="--" Foreground="#00E5FF" FontSize="13" FontFamily="Consolas" MinWidth="72"/>
                                <TextBlock Text="mm" Foreground="#00E5FF" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="V:" Foreground="#3FA9F5" FontSize="12" FontFamily="Consolas" MinWidth="20"/>
                                <TextBlock x:Name="txtVertical" Text="--" Foreground="#3FA9F5" FontSize="13" FontFamily="Consolas" MinWidth="72"/>
                                <TextBlock Text="mm" Foreground="#3FA9F5" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="D:" Foreground="Red" FontSize="12" FontFamily="Consolas" MinWidth="20"/>
                                <TextBlock x:Name="txtDistance" Text="--" Foreground="Red" FontSize="13" FontFamily="Consolas" MinWidth="72"/>
                                <TextBlock Text="mm" Foreground="Red" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>


                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
