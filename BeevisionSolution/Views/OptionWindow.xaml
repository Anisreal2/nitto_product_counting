<UserControl x:Class="BeevisionSolution.Views.OptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BeevisionSolution.Views"
        mc:Ignorable="d"
        Background="{StaticResource BackgroundBrush}"
        >

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Visibility="Collapsed" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="&#x1F310;" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource optHeadDiagram}" Foreground="White" 
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Canvas Grid.Row="1"  Background="#1E1E1E" ClipToBounds="True">
                        <Border Canvas.Left="40" Canvas.Top="50" Width="130" Height="200"
                                Background="#1A1A1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <TextBlock Text="{DynamicResource optHeadA}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="W-" Foreground="Yellow" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,30,0,0"/>
                                <TextBlock Text="W+" Foreground="Yellow" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,5,0"/>
                                <TextBlock Text="Y+" Foreground="Cyan" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"/>
                                <TextBlock Text="Y-" Foreground="Cyan" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"/>
                                <TextBlock Text="X-" Foreground="Lime" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <TextBlock Text="X+" Foreground="Lime" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Ellipse Width="10" Height="10" Fill="Red" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Canvas.Left="190" Canvas.Top="50" Width="130" Height="200"
                                Background="#1A1A1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <TextBlock Text="{DynamicResource optHeadB}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="W-" Foreground="Yellow" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,30,0,0"/>
                                <TextBlock Text="W+" Foreground="Yellow" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,5,0"/>
                                <TextBlock Text="Y+" Foreground="Cyan" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"/>
                                <TextBlock Text="Y-" Foreground="Cyan" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"/>
                                <TextBlock Text="X-" Foreground="Lime" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <TextBlock Text="X+" Foreground="Lime" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Ellipse Width="10" Height="10" Fill="Red" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F680;" Foreground="{StaticResource StatusGreenBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optMotionLimit}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" x:Name="tbMotionLimitX" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" x:Name="tbMotionLimitY" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="θ:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}" x:Name="tbMotionLimitTheta" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="deg" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Visibility="Visible">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F504;" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optRetryMode}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox Content="{DynamicResource optUseRetry}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkUseRetryMode" Margin="0,3,0,10"/>

                            <Grid IsEnabled="{Binding IsChecked, ElementName=chkUseRetryMode}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Retry X:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbRetryX" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Retry Y:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbRetryY" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Retry θ:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbRetryTheta" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="deg" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <!--// max retries-->
                                <!--<TextBlock Grid.Row="3" Grid.Column="0" Text="Max Retries:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbMaxRetries" Margin="0,3" PreviewTextInput="tbMaxRetries_PreviewTextInput" TextChanged="tbMaxRetries_TextChanged"/>-->
                                <!--<TextBlock Grid.Row="3" Grid.Column="2" Text="times" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>-->
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,15,0,0" Visibility="Visible">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F504;" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retry Count" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid IsEnabled="{Binding IsChecked, ElementName=chkUseRetryMode}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Retry Count:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbMaxRetries" Margin="0,3" PreviewTextInput="tbMaxRetries_PreviewTextInput" TextChanged="tbMaxRetries_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="times" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>

                            <CheckBox Content="OPCall MultiMark" Style="{StaticResource DarkCheckBoxStyle}" Name="chkUseOpCallForMultiMark" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F526;" Foreground="Yellow" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Light Control" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox Content="IsLightControl"
                  Style="{StaticResource DarkCheckBoxStyle}"
                  Name="chkIsLightControl"
                  Margin="0,3,0,10"
                  Checked="chkIsLightControl_CheckedChanged"
                  Unchecked="chkIsLightControl_CheckedChanged"/>

                            <StackPanel Name="spAllLightButtons" Visibility="Collapsed">
                                <Button Content="On all light"
                    Style="{StaticResource DarkButton}"
                    Name="btnOnAllLight"
                    Click="btnOnAllLight_Click"
                    MinWidth="150"
                    Margin="0,4,0,0"/>

                                <Button Content="Off all light"
                    Style="{StaticResource DarkButton}"
                    Name="btnOffAllLight"
                    Click="btnOffAllLight_Click"
                    MinWidth="150"
                    Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                    </Border>
                    
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,5,0">

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F4BE;" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optLogImage}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource optImageSaving}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <CheckBox Visibility="Collapsed" Content="{DynamicResource optSaveScreenshot}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkSaveScreenshotImage" Margin="0,3"/>
                            <CheckBox Content="{DynamicResource optSaveOkRaw}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkSaveOkRaw" Margin="0,3"/>
                            <CheckBox Content="{DynamicResource optSaveNgRaw}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkSaveNgRaw" Margin="0,3,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Saving Format:" Foreground="White" VerticalAlignment="Center" Margin="0,5,8,5"/>
                                <ComboBox Grid.Column="1" Name="cbSavingImageFormat" Style="{StaticResource DarkComboBoxStyle}" Foreground="Black" Margin="0,3" SelectedIndex="0">
                                    <ComboBoxItem Content="PNG (*.png)" Tag="Png"/>
                                    <ComboBoxItem Content="JPEG (*.jpg)" Tag="Jpeg"/>
                                    <ComboBoxItem Content="BMP (*.bmp)" Tag="Bmp"/>
                                    <ComboBoxItem Content="TIFF (*.tiff)" Tag="Tiff"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Image Factor OK:" Foreground="White" VerticalAlignment="Center" Margin="0,5,8,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbImageFactorOK" Margin="0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Image Factor NG:" Foreground="White" VerticalAlignment="Center" Margin="0,5,8,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Name="tbImageFactorNG" Margin="0,3"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Overlay Line Width:"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,5,8,5"/>
                                <TextBox Grid.Column="1"
                                         x:Name="tbOverlayLineWidth"
                                         Style="{StaticResource DarkTextBox}"
                                         MinWidth="60"
                                         Margin="0,3"/>
                                <TextBlock Grid.Column="2"
                                           Text="px (1-20)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="5,0,0,0"/>
                            </Grid>

                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,5"/>

                            <TextBlock Text="{DynamicResource optScoreLimit}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <CheckBox Content="{DynamicResource optModifyScore}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkModifyScoreLimit" Margin="0,3,0,10"/>
                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=chkModifyScoreLimit}" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource optScoreThreshold}" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Name="txtScoreLimit" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x23F1;" Foreground="Yellow" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optInspectionTiming}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource optDelayTime}" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Name="txtInspectDelay" Width="60"/>
                                <TextBlock Text="s" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,10"/>

                            <!-- MultiMark length check settings are stored per PlcCam. -->
                            <TextBlock Text="MultiMark Length Check"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbLengthCheckPlcCam"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      Foreground="Black"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="cmbLengthCheckPlcCam_SelectionChanged"
                                      Margin="0,0,0,6"/>
                            <TextBlock x:Name="txtNoMultiMarkPlcCam"
                                       Text="No MultiMark PLC Job is configured."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="0,0,0,6"/>

                            <StackPanel x:Name="spLengthCheckDetails" Margin="0,0,0,10">
                                <CheckBox Content="Enable Length Check"
                                          x:Name="chkEnableLengthCheck"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,6"/>

                            <Grid IsEnabled="{Binding IsChecked, ElementName=chkEnableLengthCheck}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Expected Length:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox x:Name="tbExpectedLength" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding ExpectedLengthText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tolerance (±):" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox x:Name="tbLengthTolerance" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Length Offset:" Foreground="White" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                <TextBox x:Name="tbLengthOffset" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                            </StackPanel>

                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,10"/>

                            <!-- Cross Line scale (mm/pixel) -->
                            <TextBlock Text="Cross Line Scale (mm/px)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Style="{StaticResource DarkTextBox}" Name="tbCrossLineScale" Width="80"/>
                                <TextBlock Text="mm/px" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource optAutoBackup}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource optInterval}" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Style="{StaticResource DarkTextBox}" x:Name="tbAutoBackupTimeHours" Width="60"/>
                                <TextBlock Text="h" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F4BD;" Foreground="Lime" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optStorageMgmt}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox Content="{DynamicResource optAutoCleanUp}" 
                                      Style="{StaticResource DarkCheckBoxStyle}" 
                                      Name="chkAutoCleanUp" 
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource optMaintainFreeSpace}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                <TextBox Style="{StaticResource DarkTextBox}" Name="txtDriveSpaceThreshold" Width="60" />
                                <TextBlock Text="%" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource optDeleteOlderThan}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                <TextBox Style="{StaticResource DarkTextBox}" 
                                         Name="tbDaysInHistory" 
                                         Width="60"
                                         PreviewTextInput="tbDaysInHistory_PreviewTextInput"
                                         TextChanged="tbDaysInHistory_TextChanged"/>
                                <TextBlock Text="{DynamicResource strDate}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,10"/>

                            <!-- Log Directory  -->
                            <TextBlock Text="{DynamicResource optLogfilepath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,5"/>
                            <Grid Margin="0,3,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}" 
                                         Name="txtSavingImageDirectory"
                                         IsReadOnly="True"
                                         IsHitTestVisible="False"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,5,0"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DarkButton}"
                                        Name="btnBrowseLogDirectory"
                                        Click="btnBrowseLogDirectory_Click"
                                        MinWidth="80"
                                        Padding="8,5">
                                    <TextBlock Text="Select..." VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,10"/>

                            <TextBlock Text="{DynamicResource optTotalSpace}"  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding TotalSpace}" Name="txtTotalSpace" Foreground="Cyan" FontFamily="Consolas" Margin="0,3,0,10"/>

                            <TextBlock Text="{DynamicResource optFreeSpace}"  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding FreeSpace}" x:Name="txtFreeSpace" Foreground="Lime" FontFamily="Consolas" Margin="0,3,0,0"/>
                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,10"/>

                            <!-- Root Folder Directory  -->
                            <TextBlock Text="Screen shot Folder" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,5"/>
                            <Grid Margin="0,3,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}" 
                                         Name="txtRootFolder"
                                         IsReadOnly="True"
                                         IsHitTestVisible="False"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,5,0"/>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DarkButton}"
                                        Name="btnBrowseRootFolder"
                                        Click="btnBrowseRootFolder_Click"
                                        MinWidth="80"
                                        Padding="8,5">
                                    <TextBlock Text="Select..." VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Separator Style="{StaticResource DarkSeparatorStyle}" Margin="0,10"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F4E6;" Foreground="Lime" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optAutoZipBackup}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CheckBox Content="{DynamicResource optEnableAutoZipBackup}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkEnableAutoZipBackup" Margin="0,3,0,10"/>

                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=chkEnableAutoZipBackup}">
                                <TextBlock Text="{DynamicResource optZipBackupInterval}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBox Style="{StaticResource DarkTextBox}" Name="tbZipBackupIntervalDays" Width="60"/>
                                    <TextBlock Text="{DynamicResource strDays}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x1F4CF;"  FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optSizeLimit}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource optMaxSize}" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Style="{StaticResource DarkTextBox}" x:Name="tbSizeLimit" Width="60"/>
                                <TextBlock Text="mm" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#x2699;"  FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource optGeneral}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Visibility="Collapsed" Content="{DynamicResource optAutoModelChange}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkAutoModelChange" Margin="0,3"/>
                            <CheckBox Content="{DynamicResource optShowCenterLine}" Style="{StaticResource DarkCheckBoxStyle}" Name="chkShowCenterLine" Margin="0,3"/>
                            
                        </StackPanel>
                    </Border>
                    
                    
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource strSave}" Style="{StaticResource DarkButton}" Name="btnSave" Click="btnSave_Click" MinWidth="120" Margin="10,0"/>
        </StackPanel>
    </Grid>
</UserControl>
