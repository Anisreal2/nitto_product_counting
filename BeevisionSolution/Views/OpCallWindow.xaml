<Window x:Class="BeevisionSolution.Views.OpCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BeevisionSolution.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="OPCALL" Height="650" Width="1024" Loaded="Window_Loaded"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section with Error and Job Name -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderRedBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,2"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                          Text="ERROR" 
                          Foreground="White" 
                          FontSize="18" 
                          FontWeight="Bold" 
                          FontFamily="Segoe UI"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Job: " 
                              Foreground="{StaticResource TextSecondaryBrush}" 
                              FontSize="14" 
                              FontFamily="Segoe UI"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtJobName" 
                              Text="Unknown" 
                              Foreground="White" 
                              FontSize="16" 
                              FontWeight="SemiBold" 
                              FontFamily="Segoe UI"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <WindowsFormsHost Grid.Row="1" 
                         Background="Black" 
                         Name="hostParent" 
                         Visibility="Visible"/>
        
        <!-- Footer Button Panel -->
        <Border Grid.Row="2" 
                Background="{StaticResource PanelBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,2,0,0"
                Padding="10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnOpCallNG" 
                       Grid.Column="1" 
                       Content="NG" 
                       Style="{StaticResource DarkButton}"
                       Background="{StaticResource NGStatusBrush}"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="5,0" 
                       Click="btnOpCallNG_Click"
                       MinWidth="120"
                       Height="40"/>
                
                <Button x:Name="btnManual" 
                       Grid.Column="2" 
                       Content="Mark Manually" 
                       Style="{StaticResource DarkButton}"
                       Margin="5,0" 
                       Click="btnManual_Click"
                       MinWidth="150"
                       Height="40"/>
                
                <Button x:Name="btnSetManual" 
                       Grid.Column="3" 
                       Content="Confirmed Manually" 
                       Style="{StaticResource DarkButton}"
                       Margin="5,0" 
                       Click="btnSetManual_Click" 
                       IsEnabled="False"
                       MinWidth="180"
                       Height="40"/>
                
                <Button x:Name="btnGrabImage" 
                       Grid.Column="4" 
                       Content="Retry" 
                       Style="{StaticResource DarkButton}"
                       Background="{StaticResource AccentCyanBrush}"
                       Foreground="Black"
                       Margin="5,0" 
                       Click="btnGrabImage_Click" 
                       Visibility="Hidden"
                       MinWidth="120"
                       Height="40"/>
            </Grid>
        </Border>
    </Grid>
</Window>
