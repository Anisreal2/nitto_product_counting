<UserControl x:Class="BeevisionSolution.Views.MotionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100" Background="#1E1E1E">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#252526"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#333333"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E1E1E1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Motion Navigation Tab Item Style -->
        <Style x:Key="MotionNavTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2E8B57"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#333337"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Tile Button Style -->
        <Style x:Key="StatusTileBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="HighContrastDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <!-- ================= MAIN TAB INTERFACE ================= -->
        <TabControl Background="Transparent" BorderThickness="0">
            
            <!-- ================= TAB 1: MAIN (Overview, Status Matrix, Motion Log, Bottom Action Bar) ================= -->
            <TabItem Header="MAIN" Style="{StaticResource MotionNavTabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>   <!-- 3-Column Body (Overview | Status Matrix | Motion Log) -->
                        <RowDefinition Height="56"/>  <!-- Bottom Action Bar -->
                    </Grid.RowDefinitions>

                    <!-- Middle 2-Column Body (Overview on Left, Status Matrix & Log on Right) -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>   <!-- Column 0: Sequence Pipeline & Actuators -->
                            <ColumnDefinition Width="400"/> <!-- Column 1: Status Matrix (Top) & Motion Log (Bottom) -->
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Sequence Pipeline & Actuators Dashboard -->
                        <Grid Grid.Column="0" Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top: Sequence Pipeline -->
                                <RowDefinition Height="*"/>     <!-- Bottom: Pneumatics & Robot Handshake Dashboard -->
                            </Grid.RowDefinitions>

                            <!-- 1. Sequence Pipeline -->
                            <GroupBox Grid.Row="0" Header="Sequence Process Pipeline" Margin="0,0,0,3">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Top Controls & Cycle Stats -->
                                        <RowDefinition Height="Auto"/> <!-- Process Step Cards Timeline -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Controls & Cycle Stats -->
                                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Axis Selector & Simulation -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="AxisArrow" Width="18" Height="18" Foreground="#007ACC" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Axis:" Foreground="#888888" FontSize="13" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="cboAxisSelect" Width="200" SelectedIndex="0" FontSize="13" FontWeight="Bold" SelectionChanged="CboAxisSelect_SelectionChanged">
                                                    <ComboBoxItem Content="{DynamicResource strMotionPressAxis}"/>
                                                </ComboBox>
                                                <CheckBox x:Name="chkSimulate" Content="Simulate" FontSize="13" FontWeight="Bold" Margin="10,0,0,0" Checked="ChkSimulate_Changed" Unchecked="ChkSimulate_Changed"/>
                                            </StackPanel>

                                            <!-- Live Cycle Info Badges -->
                                            <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                                                <Border Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="Counter" Width="16" Height="16" Foreground="#00BFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Cycles: " Foreground="#888888" FontSize="13"/>
                                                        <TextBlock x:Name="txtSeqCycleCount" Text="0" FontWeight="Bold" Foreground="#00BFFF" FontSize="14"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#1E2A38" BorderBrush="#2E8B57" BorderThickness="1.5" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="TimerOutline" Width="16" Height="16" Foreground="#00FF7F" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Time: " Foreground="#888888" FontSize="13"/>
                                                        <TextBlock x:Name="txtSeqCycleTime" Text="0.00 s" FontWeight="Bold" Foreground="#00FF7F" FontSize="14"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="4" Padding="8,4" Margin="3,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="MotionSensor" Width="16" Height="16" Foreground="#CCCCCC" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="State: " Foreground="#888888" FontSize="13"/>
                                                        <TextBlock x:Name="txtSeqStateBadge" Text="IDLE" FontWeight="Bold" Foreground="#CCCCCC" FontSize="14"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Process Step Cards Timeline (4-Node Pipeline) -->
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,2">
                                        <!-- Step 1 Card: Two-Hand Safety Trigger -->
                                        <Border x:Name="cardStep1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="6" Margin="3" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="STEP 1" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                    <iconPacks:PackIconMaterial Kind="GestureTap" Width="36" Height="36" Foreground="#00BFFF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="2-Hand Trigger" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="IDEC YW1L Dual-Btn" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="10" Padding="12,3" HorizontalAlignment="Center" Grid.Row="2">
                                                    <TextBlock x:Name="txtStep1Status" Text="READY" FontWeight="Bold" Foreground="#00BFFF" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Step 2 Card: Clamping & Force Control -->
                                        <Border x:Name="cardStep2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="6" Margin="3" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="STEP 2" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                    <iconPacks:PackIconMaterial Kind="ArrowCollapseDown" Width="36" Height="36" Foreground="#00FF7F" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Clamp &amp; Force" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Bongshin CBFSB-10" Foreground="#00FF7F" FontSize="12" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#1E2A38" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="10" Padding="12,3" HorizontalAlignment="Center" Grid.Row="2">
                                                    <TextBlock x:Name="txtStep2Status" Text="WAIT" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Step 3 Card: Trigger Vision 65MP & Count 100 -->
                                        <Border x:Name="cardStep3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="6" Margin="3" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="STEP 3" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                    <iconPacks:PackIconMaterial Kind="CameraIris" Width="36" Height="36" Foreground="#FFD700" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Count &amp; Reverse" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="65MP &amp; Backlight" Foreground="#FFD700" FontSize="12" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#1E2A38" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="10" Padding="12,3" HorizontalAlignment="Center" Grid.Row="2">
                                                    <TextBlock x:Name="txtStep3Status" Text="WAIT" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Step 4 Card: Unclamp & Tower Signals -->
                                        <Border x:Name="cardStep4" Background="#252526" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="6" Margin="3" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="STEP 4" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                    <iconPacks:PackIconMaterial Kind="ArrowExpandVertical" Width="36" Height="36" Foreground="#FF8C00" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Unclamp &amp; Signal" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Retract 0mm / Tower" Foreground="#FF8C00" FontSize="12" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#1E2A38" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="10" Padding="12,3" HorizontalAlignment="Center" Grid.Row="2">
                                                    <TextBlock x:Name="txtStep4Status" Text="WAIT" FontWeight="Bold" Foreground="#888888" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </GroupBox>

                            <!-- 2. Nitto Two-Hand Safety Trigger & Sensors / Tower Signals -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/> <!-- Two-Hand Safety & Force Control -->
                                    <ColumnDefinition Width="*"/> <!-- Optical Sensors & Tower Signals -->
                                </Grid.ColumnDefinitions>

                                <!-- Left: Two-Hand Safety & Loadcell Force Control -->
                                <GroupBox Grid.Column="0" Header="{DynamicResource strMotionTwoHandSafety}" Margin="0,0,2,0">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- IDEC Two-Hand Pushbutton Indicators -->
                                        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="ledTriggerLeft" Width="18" Height="18" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionLeftTrigger}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Name="txtTriggerLeftStatus" Text="RELEASED (DI 0)" FontSize="11" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="ledTriggerRight" Width="18" Height="18" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionRightTrigger}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        <TextBlock x:Name="txtTriggerRightStatus" Text="RELEASED (DI 1)" FontSize="11" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Bongshin Loadcell Force Feedback -->
                                        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3,0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="ledForceReached" Width="20" Height="20" Fill="#3F3F46" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource strMotionForceControl}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="txtForceStatus" Text="Force Status: STANDBY (DI 2)" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#1E2A38" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                    <TextBlock x:Name="txtForceBadge" Text="BS-205-35" FontSize="11" FontWeight="Bold" Foreground="#00BFFF"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Quick Clamping & Unclamping Action Buttons -->
                                        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,3,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnClampDown" Grid.Column="0" Content="{DynamicResource strMotionClampDown}" Height="38" Margin="2" Background="#007ACC" FontSize="12" FontWeight="Bold" Click="BtnClampDown_Click"/>
                                                <Button x:Name="btnRetractUp" Grid.Column="1" Content="{DynamicResource strMotionRetractUp}" Height="38" Margin="2" Background="#2D2D30" FontSize="12" FontWeight="Bold" Click="BtnRetractUp_Click"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </GroupBox>

                                <!-- Right: Optical Sensors (Misumi) & Tower Signals (Qlight) -->
                                <GroupBox Grid.Column="1" Header="{DynamicResource strMotionSensorsTower}" Margin="2,0,0,0">
                                    <Grid Margin="4">
                                        <UniformGrid Columns="2">
                                            <!-- Misumi Home/Upper Standby Sensor -->
                                            <Border x:Name="borderHomeUp" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                                    <Ellipse x:Name="ledHomeUpSensor" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionHomeUpSensor}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Misumi MSX674N (DI 3)" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Misumi Down Limit Sensor -->
                                            <Border x:Name="borderDownLimit" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                                    <Ellipse x:Name="ledDownLimitSensor" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionDownLimitSensor}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Misumi MSX674N (DI 4)" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Misumi Part on Jig Sensor -->
                                            <Border x:Name="borderPartPresent" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                                    <Ellipse x:Name="ledPartPresentSensor" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionPartPresentSensor}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Misumi MSX674N (DI 5)" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tower Light Green -->
                                            <Border x:Name="borderTowerGreen" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                                    <Ellipse x:Name="ledTowerGreen" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionTowerGreen}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Qlight Tower (DO 0)" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tower Light Red -->
                                            <Border x:Name="borderTowerRed" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                                    <Ellipse x:Name="ledTowerRed" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionTowerRed}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Qlight Tower (DO 1)" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Backlight Output -->
                                            <Border x:Name="borderBacklight" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="2" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0">
                                                    <Ellipse x:Name="ledBacklight" Width="14" Height="14" Fill="#3F3F46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource strMotionBacklight}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="White Backlight (DO 4)" FontSize="10" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </Grid>

                        <!-- Column 1: Right Side (Status Matrix on Top, Motion Log on Bottom) -->
                        <Grid Grid.Column="1" Margin="3,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Status Matrix & Readouts -->
                                <RowDefinition Height="*"/>    <!-- Row 1: Motion Log -->
                            </Grid.RowDefinitions>

                            <!-- Top: Status Matrix & Coordinates -->
                            <GroupBox Grid.Row="0" Header="Status Matrix" Margin="0,0,0,4">
                                <StackPanel Margin="2">
                                    <!-- 2x6 Status Tile Matrix -->
                                    <UniformGrid Columns="2">
                                        <Border x:Name="tileAlm" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="ALM" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileWarn" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="WARN" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileEmg" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="EMG" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileHome" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="HOME" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileLmPos" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="LM +" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileSvOn" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="SvOn" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileLmNeg" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="LM -" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileInp" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="INP" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileLight" Style="{StaticResource StatusTileBorder}" Background="#8B0000">
                                            <TextBlock Text="Light" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileBusy" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="Busy" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tileForce" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="Force" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="tilePart" Style="{StaticResource StatusTileBorder}">
                                            <TextBlock Text="Part" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Readout Details (2-Column compact layout) -->
                                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Mode:" Foreground="#888888" FontSize="13"/>
                                                    <TextBlock x:Name="txtModeStatus" Text="MANUAL" FontWeight="Bold" Foreground="#00FF7F" FontSize="14" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Pos:" Foreground="#888888" FontSize="13"/>
                                                    <TextBlock x:Name="txtActualPos" Text="0.000 mm" FontWeight="Bold" Foreground="#00BFFF" FontSize="14" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Vel:" Foreground="#888888" FontSize="13"/>
                                                    <TextBlock x:Name="txtActualVel" Text="0.0 mm/s" FontWeight="Bold" Foreground="#FFD700" FontSize="14" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="Master:" Foreground="#888888" FontSize="13"/>
                                                    <TextBlock x:Name="txtMasterStatus" Text="OP (6)" FontWeight="Bold" Foreground="#00FF7F" FontSize="14" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- Bottom: Motion Log -->
                            <GroupBox Grid.Row="1" Header="{DynamicResource strMotionActivityLogs}" Margin="0,2,0,0">
                                <Grid Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                        <Button x:Name="btnClearLog" Padding="10,3" FontSize="12" FontWeight="Bold" Click="BtnClearLog_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="DeleteSweepOutline" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource strMotionClearLog}" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnCopyLog" Padding="10,3" FontSize="12" FontWeight="Bold" Click="BtnCopyLog_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Copy" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBox x:Name="txtMotionLogs" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#121212" Foreground="#00FF7F" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- Bottom Action Bar (Large prominent buttons) -->
                    <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="4">
                        <UniformGrid Columns="7">
                            <Button x:Name="btnAutoMode" Height="48" Click="BtnAutoMode_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="Play" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AUTO" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnManualMode" Height="48" Background="#2E8B57" Click="BtnManualMode_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="GamepadVariant" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MANUAL" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnHome" Height="48" Click="BtnHome_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="Home" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="HOME" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnReset" Height="48" Click="BtnReset_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="RESET" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnServoToggle" Height="48" Click="BtnServoToggle_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial x:Name="iconServo" Kind="Power" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtServoBtn" Text="Servo ON" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTriggerCam" Height="48" Click="BtnTriggerCam_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="Camera" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="TriggerCam" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTurnLight" Height="48" Click="BtnLightToggle_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="Lightbulb" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Turn Light" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: SETTING (Teaching Points, Manual JOG, PTP, Pneumatics, Light COM) ================= -->
            <TabItem Header="SETTING" Style="{StaticResource MotionNavTabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Left: Teaching Points Table -->
                        <ColumnDefinition Width="380"/> <!-- Right: Manual Jog & Peripherals -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Teaching Points Table -->
                    <GroupBox Grid.Column="0" Header="{DynamicResource strMotionTeachingPoints}">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgTeachingPoints" Grid.Row="0" Style="{StaticResource HighContrastDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="35"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                                    <DataGridTextColumn Header="Axis" Binding="{Binding AxisIndex}" Width="45"/>
                                    <DataGridTextColumn Header="Position (mm)" Binding="{Binding Position, StringFormat={}{0:F3}}" Width="95"/>
                                    <DataGridTextColumn Header="Speed (mm/s)" Binding="{Binding Speed, StringFormat={}{0:F0}}" Width="90"/>
                                    <DataGridTextColumn Header="Step Type" Binding="{Binding StepType}" Width="100"/>
                                    <DataGridTextColumn Header="Order" Binding="{Binding StepOrder}" Width="50"/>
                                    <DataGridTextColumn Header="Dwell (ms)" Binding="{Binding DwellTimeMs}" Width="75"/>
                                    <DataGridCheckBoxColumn Header="Vision" Binding="{Binding TriggerVision}" Width="50"/>
                                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="55"/>
                                    <DataGridTextColumn Header="On NG" Binding="{Binding ActionOnNg}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button x:Name="btnTeachCurrent" Content="{DynamicResource strMotionTeachCurrent}" Background="#007ACC" Click="BtnTeachCurrent_Click"/>
                                <Button x:Name="btnRunToPoint" Content="{DynamicResource strMotionMovePoint}" Background="#2E8B57" Click="BtnRunToPoint_Click"/>
                                <Button x:Name="btnAddPoint" Content="{DynamicResource strMotionAddPoint}" Click="BtnAddPoint_Click"/>
                                <Button x:Name="btnDeletePoint" Content="{DynamicResource strMotionDeletePoint}" Background="#8B0000" Click="BtnDeletePoint_Click"/>
                                <Button x:Name="btnSavePoints" Content="{DynamicResource strMotionSavePoints}" Background="#2D2D30" Click="BtnSavePoints_Click"/>
                                <Button x:Name="btnReloadPoints" Content="{DynamicResource strMotionReloadConfig}" Background="#2D2D30" Click="BtnReloadPoints_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Right: Manual JOG, PTP, Pneumatics & Light Control -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="3">
                            <!-- 1. Manual JOG & PTP -->
                            <GroupBox Header="{DynamicResource strMotionManualMotion}">
                                <StackPanel Margin="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <RadioButton x:Name="rbJogContinuous" Content="{DynamicResource strMotionJogContinuous}" IsChecked="True" Checked="RbJogMode_Changed"/>
                                            <RadioButton x:Name="rbJogStep" Content="{DynamicResource strMotionJogStep}" Checked="RbJogMode_Changed"/>
                                        </StackPanel>
                                        <ComboBox x:Name="cboStepDistance" Grid.Column="1" Width="75" HorizontalAlignment="Right" Visibility="Collapsed" SelectedIndex="1">
                                            <ComboBoxItem Content="0.1 mm"/>
                                            <ComboBoxItem Content="1.0 mm"/>
                                            <ComboBoxItem Content="5.0 mm"/>
                                            <ComboBoxItem Content="10.0 mm"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnJogNeg" Grid.Column="0" Content="◀ JOG -" Height="34" FontSize="13" PreviewMouseDown="BtnJogNeg_PreviewMouseDown" PreviewMouseUp="BtnJogNeg_PreviewMouseUp"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                            <TextBlock Text="Speed:"/>
                                            <TextBox x:Name="txtJogSpeed" Text="50" Width="40" TextAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="btnJogPos" Grid.Column="2" Content="JOG + ▶" Height="34" FontSize="13" PreviewMouseDown="BtnJogPos_PreviewMouseDown" PreviewMouseUp="BtnJogPos_PreviewMouseUp"/>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Target:" Grid.Column="0"/>
                                        <TextBox x:Name="txtTargetPos" Text="100.000" Grid.Column="1"/>
                                        <Button x:Name="btnMoveAbs" Grid.Column="2" Content="{DynamicResource strMotionMoveAbs}" Click="BtnMoveAbs_Click"/>
                                        <Button x:Name="btnMoveRel" Grid.Column="3" Content="{DynamicResource strMotionMoveRel}" Click="BtnMoveRel_Click"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 2. Manual Clamping Quick Controls -->
                            <GroupBox Header="{DynamicResource strMotionManualClamping}">
                                <UniformGrid Columns="2" Margin="3">
                                    <Button x:Name="btnQuickClamp" Content="{DynamicResource strMotionClampDown}" Height="34" Click="BtnClampDown_Click"/>
                                    <Button x:Name="btnQuickRetract" Content="{DynamicResource strMotionRetractUp}" Height="34" Click="BtnRetractUp_Click"/>
                                </UniformGrid>
                            </GroupBox>

                            <!-- 3. Test Program & Simulation Mode -->
                            <GroupBox Header="Test Program &amp; Simulation">
                                <StackPanel Margin="3">
                                    <CheckBox x:Name="chkTestProgramMode" Content="Enable Mock Test Simulation" FontWeight="Bold" Foreground="#FFD700" Checked="ChkTestProgramMode_Changed" Unchecked="ChkTestProgramMode_Changed"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                            <TextBlock Text="Mock Vision Result:" FontSize="10"/>
                                            <ComboBox x:Name="cbMockVisionResult" SelectedIndex="0" SelectionChanged="CbMockVisionResult_SelectionChanged">
                                                <ComboBoxItem Content="OK (100 Pcs)"/>
                                                <ComboBoxItem Content="NG1 (Count 99)"/>
                                                <ComboBoxItem Content="NG2 (Reverse)"/>
                                                <ComboBoxItem Content="NG3 (Defect)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                            <TextBlock Text="Simulate Trigger:" FontSize="10"/>
                                            <Button x:Name="btnSimulateTrigger" Content="{DynamicResource strMotionSimulateTwoHand}" Height="26" Click="BtnSimulateTrigger_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3: ALARM & DIAGNOSTICS ================= -->
            <TabItem Header="ALARM" Style="{StaticResource MotionNavTabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Current Alarm Code:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtAlarmCode" Text="0x0000 (No Error)" FontWeight="Bold" Foreground="#00FF7F" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnForceServoOn" Grid.Column="1" Content="⚡ Force Servo ON" Background="#2E8B57" Height="30" Click="BtnForceServoOn_Click" ToolTip="Force CiA 402 Servo Enable Sequence (0x6040)"/>
                            <Button x:Name="btnToggleEmg" Grid.Column="2" Content="⚡ Toggle EMG Inv" Background="#4B0082" Height="30" Click="BtnToggleEmg_Click" ToolTip="Toggle Hardware Emergency Stop Inversion"/>
                            <Button x:Name="btnScanBus" Grid.Column="3" Content="{DynamicResource strMotionScanBus}" Background="#2D2D30" Height="30" Click="BtnScanBus_Click" ToolTip="Download XML Configs and Rescan EtherCAT Bus"/>
                            <Button x:Name="btnClearAlarm" Grid.Column="4" Content="{DynamicResource strMotionResetAlarm}" Background="#007ACC" Height="30" Click="BtnClearAlarm_Click"/>
                            <Button x:Name="btnClearHistory" Grid.Column="5" Content="{DynamicResource strMotionClearHistory}" Height="30" Click="BtnClearHistory_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgAlarmHistory" Grid.Row="1" Style="{StaticResource HighContrastDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeFormatted}" Width="140"/>
                            <DataGridTextColumn Header="Axis" Binding="{Binding AxisName}" Width="80"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding CodeHex}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="Description / Message" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: ADVANCED CONFIG ================= -->
            <TabItem Header="ADVANCED" Style="{StaticResource MotionNavTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Mechanical & Soft Limits -->
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <GroupBox Header="Mechanical Parameters">
                                <StackPanel Margin="3">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pulses Per mm (pulse/mm):" Grid.Column="0"/>
                                        <TextBox x:Name="txtPulsePerUnit" Text="1000.0" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Max Velocity (mm/s):" Grid.Column="0"/>
                                        <TextBox x:Name="txtMaxVel" Text="50000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Acceleration (mm/s²):" Grid.Column="0"/>
                                        <TextBox x:Name="txtMaxAcc" Text="500000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Deceleration (mm/s²):" Grid.Column="0"/>
                                        <TextBox x:Name="txtMaxDec" Text="500000" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Software Limits" Margin="0,4,0,0">
                                <StackPanel Margin="3">
                                    <CheckBox x:Name="chkEnableSoftLimits" Content="Enable Software Limits" IsChecked="True" Margin="0,3"/>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Positive Limit (+ mm):" Grid.Column="0"/>
                                        <TextBox x:Name="txtSoftLimitPos" Text="150.0" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Negative Limit (- mm):" Grid.Column="0"/>
                                        <TextBox x:Name="txtSoftLimitNeg" Text="-5.0" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Right Column: Homing & IO Bit Mapping -->
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <GroupBox Header="Homing Parameters">
                                <StackPanel Margin="3">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Homing Method:" Grid.Column="0"/>
                                        <ComboBox x:Name="cboHomingMode" Grid.Column="1" SelectedIndex="3">
                                            <ComboBoxItem Content="Direct (0)"/>
                                            <ComboBoxItem Content="Negative Limit (1)"/>
                                            <ComboBoxItem Content="Positive Limit (2)"/>
                                            <ComboBoxItem Content="Home Sensor (33)"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="High Search Velocity:" Grid.Column="0"/>
                                        <TextBox x:Name="txtHomeHighSpeed" Text="5000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Low Creep Velocity:" Grid.Column="0"/>
                                        <TextBox x:Name="txtHomeLowSpeed" Text="1000" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Home Offset:" Grid.Column="0"/>
                                        <TextBox x:Name="txtHomeOffset" Text="0" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{DynamicResource strMotionNittoIOMapping}" Margin="0,4,0,0">
                                <StackPanel Margin="3">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Left Trigger DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitTriggerLeft" Text="0" Grid.Column="1"/>
                                        <TextBlock Text="Right Trigger DI:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitTriggerRight" Text="1" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Force Reached DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitForceReached" Text="2" Grid.Column="1"/>
                                        <TextBlock Text="Home/Up Sensor DI:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitSensorHomeUp" Text="3" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Down Limit DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitSensorDownLimit" Text="4" Grid.Column="1"/>
                                        <TextBlock Text="Part on Jig DI:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitSensorPartPresent" Text="5" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Emergency Stop DI:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitSystemStop" Text="6" Grid.Column="1"/>
                                        <TextBlock Text="Camera Trigger DO:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitCamTrigger" Text="3" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tower Green DO:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitTowerGreen" Text="0" Grid.Column="1"/>
                                        <TextBlock Text="Tower Red DO:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitTowerRed" Text="1" Grid.Column="3"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tower Buzzer DO:" Grid.Column="0"/>
                                        <TextBox x:Name="txtIoBitTowerBuzzer" Text="2" Grid.Column="1"/>
                                        <TextBlock Text="Backlight DO:" Grid.Column="2" Margin="4,0,0,0"/>
                                        <TextBox x:Name="txtIoBitBacklight" Text="4" Grid.Column="3"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button x:Name="btnSaveMotionConfig" Content="{DynamicResource strMotionSaveConfig}" Background="#007ACC" Height="34" Click="BtnSaveMotionConfig_Click"/>
                                <Button x:Name="btnReloadMotionConfig" Content="{DynamicResource strMotionReloadConfig}" Background="#2D2D30" Height="34" Click="BtnReloadMotionConfig_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

