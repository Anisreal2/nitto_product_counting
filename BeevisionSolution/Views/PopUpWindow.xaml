<Window x:Class="BeevisionSolution.Views.PopUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BeevisionSolution.Views"
        xmlns:comp="clr-namespace:BeevisionSolution.ViewComponents" 
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Edit Lot" Height="310" Width="500">
    <Border BorderBrush="#ff6060ff" BorderThickness="1" Background="White">
        <Grid x:Name="contentContainer">
            <comp:LotInformation x:Name="editControl"/>
        </Grid>
    </Border>
</Window>
