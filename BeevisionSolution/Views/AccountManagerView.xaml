<UserControl x:Class="BeevisionSolution.Views.AccountManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BeevisionSolution.Views"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:BeevisionSolution.Converters"
             >
    <UserControl.Resources>
        <converters:RoleToTextConverter x:Key="RoleToTextConverter"/>
        <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>
    </UserControl.Resources>
    <Grid Margin="2,2,0,2" Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="0">
            <Grid Margin="20,0">
                <TextBlock Text="{DynamicResource strAccountManager}" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Account List -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="btnAdd" Content="{DynamicResource strCreateIcon}" 
                               Width="120" Height="35" Visibility="Collapsed"
                               Background="#4CAF50" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0"
                               Click="btnAdd_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="10,5">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45a049"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnRefresh" Content="{DynamicResource strRefresh}" 
                               Width="120" Height="35" Margin="10,0,0,0"
                               Background="#2196F3" Foreground="White" 
                               FontWeight="Bold" BorderThickness="0"
                               Click="btnRefresh_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="10,5">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1976D2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="dgAccounts" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             SelectionMode="Single"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             SelectionChanged="dgAccounts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Username}" Width="*" MinWidth="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource strUsername}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FullName}" Width="*" MinWidth="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource strFullname}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Role, Converter={StaticResource RoleToTextConverter}}" Width="200">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource strRole}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IsActive, Converter={StaticResource BoolToStatusTextConverter}}" Width="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource strStatusDisplay}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn  Binding="{Binding LastLoginDate, StringFormat='dd/MM/yyyy HH:mm'}" Width="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource strLastLogin}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Account Details Form -->
            <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <TextBlock x:Name="txtFormTitle" Text="{DynamicResource strDetailAccount}" 
                              FontSize="18" FontWeight="Bold" 
                              Foreground="#333" Margin="0,0,0,20"/>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{DynamicResource strUsername}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtUsername" Height="40" FontSize="14" 
                                Padding="10,5" Margin="0,0,0,15"/>

                        <TextBlock Text="{DynamicResource strPassword}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtPassword" Height="35" FontSize="14" 
                                    Padding="10,5" Margin="0,0,0,15"/>

                        <TextBlock Text="{DynamicResource strFullname}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFullName" Height="40" FontSize="14" 
                                Padding="10,5" Margin="0,0,0,15"/>

                        <TextBlock Text="{DynamicResource strRole}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboRole" Height="35" FontSize="14" 
                                 Padding="10,5" Margin="0,0,0,15">
                            <ComboBoxItem Content="{DynamicResource strUserRoleAdmin}" Tag="Master"/>
                            <ComboBoxItem Content="{DynamicResource strUserRoleEngineer}" Tag="Engineer"/>
                            <ComboBoxItem Content="{DynamicResource strUserRoleOperator}" Tag="Operator"/>
                        </ComboBox>

                        <CheckBox x:Name="chkIsActive" Content="{DynamicResource strActiveUser}" 
                                 FontSize="14" IsChecked="True" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
                        <Button x:Name="btnSave" Content="{DynamicResource strSaveIcon}" 
                               Height="40" Background="#4CAF50" 
                               Foreground="White" FontWeight="Bold" 
                               BorderThickness="0" Click="btnSave_Click" 
                               Cursor="Hand" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45a049"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnDelete" Content="{DynamicResource strDeleteIcon}" 
                               Height="40" Background="#F44336" 
                               Foreground="White" FontWeight="Bold" 
                               BorderThickness="0" Click="btnDelete_Click" 
                               Cursor="Hand" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#da190b"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnCancel" Content="{DynamicResource strCancel}" 
                               Height="40" Background="#9E9E9E" 
                               Foreground="White" FontWeight="Bold" 
                               BorderThickness="0" Click="btnCancel_Click" 
                               Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                       CornerRadius="3" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                     VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
