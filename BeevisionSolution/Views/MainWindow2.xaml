<mah:MetroWindow  x:Class="BeevisionSolution.Views.MainWindow2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:BeevisionSolution.Views"
        xmlns:viewComp="clr-namespace:BeevisionSolution.ViewComponents"
        xmlns:asf="clr-namespace:Microsoft.DwayneNeed.Interop;assembly=Microsoft.DwayneNeed"
        mc:Ignorable="d"
        ShowTitleBar="False"
        ShowCloseButton="False"
        ShowMaxRestoreButton="False"
        ShowMinButton="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded"
        IgnoreTaskbarOnMaximize="True"
        KeyDown="MetroWindow_KeyDown"
        PreviewKeyDown="MetroWindow_PreviewKeyDown" Background="Black"
        Title="BEEVISION" Height="450" Width="800" ResizeMode="CanMinimize" WindowStyle="SingleBorderWindow" ContentRendered="MetroWindow_ContentRendered"
        Icon="pack://application:,,,/Resources/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <local:TopPanel Grid.Row="0" Margin="2,0,0,0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:ImageView x:Name="imageView" BorderThickness="0" Grid.Column="0"  />
            <!-- Right Panel -->

        </Grid>
        

    </Grid>
</mah:MetroWindow>
