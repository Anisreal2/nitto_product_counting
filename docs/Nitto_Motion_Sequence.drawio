  <diagram id="nitto-motion-sequence" name="Nitto Automated Production Cycle">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1850" background="#1E1E1E" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title_block" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#00D2FF&quot;&gt;NITTO PRODUCT COUNTING &amp;amp; ORIENTATION INSPECTION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CCCCCC&quot;&gt;Automated Motion Sequence &amp;amp; Hardware IO Flow (MotionSequenceManager + PcieE2I12O16IOControl)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252526;strokeColor=#3F3F46;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="700" height="70" as="geometry" />
        </mxCell>

        <!-- 1. START / IDLE -->
        <mxCell id="node_idle" value="&lt;b&gt;STATE: IDLE (Standby)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;• Trục tỳ ở cữ trên 0.0 mm&lt;br&gt;• Đèn tháp Standby / Ready&lt;br&gt;• Sẵn sàng nhận chu trình mới&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2A38;strokeColor=#007ACC;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="475" y="140" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- 2. CHECK READY -->
        <mxCell id="node_check_ready" value="&lt;b&gt;STATE: CHECKING READY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;1. Kiểm tra EtherCAT Master (State 6 - OP)&lt;br&gt;2. Mở phanh motor qua PCIe DO&lt;br&gt;3. CiA 402 Reset Alarm &amp;amp; Servo ON (EL7)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D30;strokeColor=#3F3F46;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- Condition: System Ready? -->
        <mxCell id="cond_ready" value="Master OP &amp;amp;&lt;br&gt;Servo ON?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#332A15;strokeColor=#FF8C00;strokeWidth=1.5;fontColor=#FFD700;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="515" y="365" width="170" height="75" as="geometry" />
        </mxCell>

        <!-- Error State -->
        <mxCell id="node_error" value="&lt;b&gt;STATE: ERROR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FFAAAA&quot;&gt;• Báo lỗi trên UI &amp;amp; Log&lt;br&gt;• Khóa chu trình máy&lt;br&gt;• Chờ công nhân Reset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A1515;strokeColor=#DC143C;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="840" y="367.5" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- 3. WAITING TRIGGER -->
        <mxCell id="node_wait_trigger" value="&lt;b&gt;STATE: WAITING TRIGGER&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;Công nhân xếp tệp sản phẩm vào Jig&lt;br&gt;Chờ nhấn đồng thời 2 nút an toàn IDEC YW1L&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D30;strokeColor=#3F3F46;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="460" y="475" width="280" height="65" as="geometry" />
        </mxCell>

        <!-- Hardware IO Box: Two Hand Buttons -->
        <mxCell id="io_two_hand" value="&lt;b&gt;CARD PCIE-E2I12O16&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#00FF7F&quot;&gt;DI 0: Nút ấn Trái (Pressed)&lt;br&gt;DI 1: Nút ấn Phải (Pressed)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;Debounce: 30 ms&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;fillColor=#1E3320;strokeColor=#2E8B57;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="170" y="460" width="220" height="95" as="geometry" />
        </mxCell>

        <!-- Condition: 2 Buttons Pressed? -->
        <mxCell id="cond_triggered" value="Cả 2 nút DI 0 &amp;amp; DI 1&lt;br&gt;cùng HIGH?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#1A2D20;strokeColor=#2E8B57;strokeWidth=1.5;fontColor=#00FF7F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="505" y="575" width="190" height="75" as="geometry" />
        </mxCell>

        <!-- 4. CLAMPING DOWN -->
        <mxCell id="node_clamping" value="&lt;b&gt;STATE: CLAMPING DOWN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;• Hạ trục ép (Leadshine EL7) tốc độ 50 mm/s&lt;br&gt;• Vị trí danh định: ClampingPosition (80 mm)&lt;br&gt;• Quét thời gian thực cảm biến lực Loadcell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D30;strokeColor=#3F3F46;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="455" y="685" width="290" height="75" as="geometry" />
        </mxCell>

        <!-- Hardware IO Box: Bongshin Loadcell -->
        <mxCell id="io_loadcell" value="&lt;b&gt;LOADCELL BONGSHIN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#00BFFF&quot;&gt;CBFSB-10 + BS-205-35&lt;br&gt;PCIe DI 2: Force Reached&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;(Đạt ngưỡng lực ép phẳng)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=8;fillColor=#1B2C3F;strokeColor=#007ACC;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="170" y="675" width="220" height="95" as="geometry" />
        </mxCell>

        <!-- Condition: Force Reached or Position Reached? -->
        <mxCell id="cond_force" value="Đạt lực tỳ DI 2&lt;br&gt;hoặc chạm cữ ép?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#1A2D20;strokeColor=#2E8B57;strokeWidth=1.5;fontColor=#00FF7F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="795" width="200" height="75" as="geometry" />
        </mxCell>

        <!-- 5. TRIGGERING VISION & DWELL -->
        <mxCell id="node_dwell_light" value="&lt;b&gt;STATE: TRIGGERING VISION&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;1. Dừng trục giữ lực ép cố định: Stop(0)&lt;br&gt;2. Dwell time: 150 ms (ổn định biến dạng phôi)&lt;br&gt;3. Bật đèn nền Backlight: &lt;b&gt;PCIe DO 4 = ON&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D30;strokeColor=#3F3F46;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="450" y="905" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- 6. PROCESSING VISION -->
        <mxCell id="node_vision" value="&lt;b&gt;STATE: PROCESSING VISION&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;1. Kích hoạt camera chụp ảnh biên dạng phôi&lt;br&gt;2. Cognex VisionPro ToolBlock phân tích:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Đếm số lượng sản phẩm: &lt;b&gt;100 pcs&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Kiểm tra ngược mặt sản phẩm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252526;strokeColor=#007ACC;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="450" y="1020" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- 7. UNCLAMPING UP -->
        <mxCell id="node_retract" value="&lt;b&gt;STATE: UNCLAMPING UP (Retract)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot;&gt;1. Tắt đèn Backlight: &lt;b&gt;PCIe DO 4 = OFF&lt;/b&gt;&lt;br&gt;2. Nâng trục ép mở kẹp về 0.0 mm (Vận tốc 80 mm/s)&lt;br&gt;3. Chờ trục hoàn tất di chuyển: WaitMoveDoneAsync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D2D30;strokeColor=#3F3F46;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="445" y="1145" width="310" height="85" as="geometry" />
        </mxCell>

        <!-- 8. ANTI-TIE-DOWN -->
        <mxCell id="node_antitie" value="&lt;b&gt;SAFETY: ANTI-TIE-DOWN INTERLOCK&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FFA500&quot;&gt;Bắt buộc công nhân nhả cả 2 nút nhấn IDEC&lt;br&gt;Chống chèn hoặc đè giữ nút bấm liên tục&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E2412;strokeColor=#D4AF37;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="450" y="1265" width="300" height="65" as="geometry" />
        </mxCell>

        <!-- Condition: Inspection OK or NG? -->
        <mxCell id="cond_result" value="Kết quả Vision&lt;br&gt;Đủ 100pcs &amp;amp; Đúng chiều?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#252526;strokeColor=#00D2FF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="485" y="1365" width="230" height="85" as="geometry" />
        </mxCell>

        <!-- 9. FINISHING OK -->
        <mxCell id="node_finish_ok" value="&lt;b&gt;RESULT: PASS (OK)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#00FF7F&quot;&gt;• Đèn tháp XANH ON (PCIe DO 0)&lt;br&gt;• Đèn tháp ĐỎ OFF (PCIe DO 1)&lt;br&gt;• Còi báo OFF (PCIe DO 2)&lt;br&gt;• Tăng TotalCycleCount + 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#162D1C;strokeColor=#2E8B57;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="270" y="1485" width="250" height="85" as="geometry" />
        </mxCell>

        <!-- 10. FINISHING NG -->
        <mxCell id="node_finish_ng" value="&lt;b&gt;RESULT: FAIL (NG)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FF6B6B&quot;&gt;• Đèn tháp ĐỎ ON (PCIe DO 1)&lt;br&gt;• Còi BUZZER ON 1.0s (PCIe DO 2)&lt;br&gt;• Đèn tháp XANH OFF (PCIe DO 0)&lt;br&gt;• Lưu ảnh lỗi NG &amp;amp; Cảnh báo UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#381717;strokeColor=#DC143C;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="680" y="1485" width="260" height="85" as="geometry" />
